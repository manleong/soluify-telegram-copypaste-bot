# Copy this to .env — never commit .env
# Docker Compose reads this file; the script itself does not.

# Host folder mounted as /data in the container (credentials, profiles, sessions, logs, media).
# Use forward slashes on Windows, e.g. C:/soluify-data
HOST_DATA_PATH=./data

# Media housekeeping: delete downloaded media files older than this many days
# Set to 0 to disable automatic cleanup
MEDIA_RETENTION_DAYS=3

# --- Headless (unattended) mode -------------------------------------------
# 1 = start forwarding TG_PROFILE straight away with no prompts (for `docker compose up -d`)
# 0 = interactive menu
HEADLESS=1

# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Same number used during the interactive login, digits only (e.g. 447123456789)
TG_PHONE=
# Name of a profile saved in telegramconfiguration.json
TG_PROFILE=
# Headless mode prints a "still running" status line this often (minutes); 0 = off
HEARTBEAT_MINUTES=10
# Timezone for log timestamps (IANA name, e.g. Asia/Kuala_Lumpur)
TZ=UTC
